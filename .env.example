# Copy to .env for local runs outside Docker.
# Docker Compose supplies its own development defaults and does not require this file.

DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL empty and set ALLOW_SQLITE_DEV=true only for a quick UI preview.
# The supported local database is PostgreSQL.
DATABASE_URL=postgres://medisource:medisource@localhost:5432/medisource
ALLOW_SQLITE_DEV=false

REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# Privileged accounts must enroll MFA when this is true.
# Local development defaults to false. Production settings force true.
MFA_REQUIRED_FOR_PRIVILEGED=false

SEED_DEMO_PASSWORD=Demo-Only-Change-Me-1
FORCE_SEED_DEMO=false

NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL_INTERNAL=http://localhost:8000
NEXT_PUBLIC_ENVIRONMENT=development
